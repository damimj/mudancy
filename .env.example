# Copy this file to .env.local and fill in your own values.
# In Vercel, add the same variables under Project → Settings → Environment Variables.
# Everything here is safe to expose in the browser (the anon key is public by design;
# your data is protected by the Row Level Security rules in supabase-schema.sql).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional customisation
# VITE_SITE_NAME=Mudancy
# VITE_CURRENCY=USD
# VITE_DEFAULT_LANG=en
