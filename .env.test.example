# Only needed to run the end-to-end tests (npm run test:e2e).
# Copy to .env.test.local (gitignored) and point it at a SEPARATE, empty Supabase
# project created just for tests — NEVER at your real shop. The test suite refuses
# to run unless the database contains the e2e marker table, which only
# `npm run db:setup:test` creates.

VITE_SUPABASE_URL=https://your-test-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-test-project-anon-key

# Used by the tests and the setup script to create data and sign in without a password.
# Supabase → Project Settings → API → service_role key. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-test-project-service-role-key

# Supabase → Connect → "Direct connection" (or Session pooler) URI. Only used by `npm run db:setup:test`.
POSTGRES_URL_NON_POOLING=postgresql://postgres:[YOUR-PASSWORD]@db.your-test-project-ref.supabase.co:5432/postgres

# E-mail of the test admin. The setup script adds it to the admins table.
TEST_ADMIN_EMAIL=e2e-admin@example.com
